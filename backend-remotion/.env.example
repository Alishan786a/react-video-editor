# Remotion Video Export Server Configuration

# Server Port
PORT=3001

# Remotion Configuration
REMOTION_CONCURRENCY=2
REMOTION_LOG_LEVEL=info
REMOTION_CODEC=h264
REMOTION_CRF=23

# File Storage
STORAGE_PATH=./storage
TEMP_PATH=./storage/temp
RENDERS_PATH=./storage/renders

# Video Settings
DEFAULT_FPS=30
DEFAULT_WIDTH=1080
DEFAULT_HEIGHT=1920
DEFAULT_DURATION=5000

# Performance Settings
MAX_CONCURRENT_RENDERS=2
CLEANUP_TEMP_FILES=true
CACHE_BUNDLES=true
