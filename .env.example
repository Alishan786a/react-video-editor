# React Video Editor - Environment Variables
# Copy this file to .env and update the values

# API Configuration
# Update these URLs to point to your own backend APIs

# Upload API - handles file uploads (REQUIRED)
VITE_UPLOAD_API_URL=http://localhost:3000/api/v1/editor

# Video Rendering API (OPTIONAL)
VITE_RENDER_API_URL=http://localhost:3000/api/v1/editor

# Caption Generation API (OPTIONAL)
VITE_CAPTIONS_API_URL=http://localhost:3000/api/v1/editor
