# React Video Editor - Environment Variables
# Copy this file to .env and update the values

# API Configuration
# Update these URLs to point to your own backend APIs

# Backend Type Selection
# Choose 'remotion' for high-quality free rendering or 'ffmpeg' for the original backend
VITE_BACKEND_TYPE=remotion

# Upload API - handles file uploads (REQUIRED)
VITE_UPLOAD_API_URL=http://localhost:3000/api/v1/editor

# Video Rendering API - FFmpeg Backend (OPTIONAL)
VITE_RENDER_API_URL=http://localhost:3000/api/v1/editor

# Video Rendering API - Remotion Backend (RECOMMENDED)
VITE_REMOTION_API_URL=http://localhost:3001/api/v1/editor/remotion

# Caption Generation API (OPTIONAL)
VITE_CAPTIONS_API_URL=http://localhost:3000/api/v1/editor
